# 复制为 .env 后填写；留空的密钥和模型名必须在使用对应服务前配置。
# 应用
APP_NAME=touyan
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# OpenAI 兼容聊天模型：模型名按实际服务填写
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# 嵌入服务：独立配置，维度必须与所选模型和 Milvus 集合一致
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32

# Tavily 联网搜索
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=10
HTTP_TIMEOUT_SECONDS=30

# MySQL（应用账号，不使用 root）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=touyan
MYSQL_USER=touyan
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT_SECONDS=10

# Milvus，使用远程服务，不使用 Windows 上的 Milvus Lite
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=report_chunks
MILVUS_TIMEOUT_SECONDS=30

# 分块及检索
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_TOP_K=8

# Worker：MySQL 持久任务队列，无需 Redis/Celery
WORKER_POLL_SECONDS=2
WORKER_CONCURRENCY=1
WORKER_HEARTBEAT_SECONDS=15
WORKER_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
STAGE_TIMEOUT_SECONDS=900
AGENT_RECURSION_LIMIT=40
FACT_CHECK_MAX_REVISIONS=2

# MCP：后续由 FastAPI 挂载；内部 Agent 只连接 research 入口
MCP_TRANSPORT=streamable-http
MCP_RESEARCH_PATH=/mcp/research
MCP_REPORT_PATH=/mcp/reports
MCP_RESEARCH_URL=http://127.0.0.1:8000/mcp/research
MCP_ACCESS_TOKEN=
MCP_TIMEOUT_SECONDS=120
SSE_HEARTBEAT_SECONDS=15

# 相对路径以项目根目录为基准；Windows 路径建议使用正斜杠
DATA_DIR=data
MAX_UPLOAD_MB=50
PDF_OCR_ENABLED=false
PDF_OCR_LANGUAGE=chi_sim+eng
# Word 转 PDF 需另外安装 LibreOffice；可填写 soffice.exe 完整路径
LIBREOFFICE_BINARY=soffice
EXPORT_TIMEOUT_SECONDS=120
